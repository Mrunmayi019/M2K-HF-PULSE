# Copy to .env (gitignored by the *.env rule) and fill in locally. Never commit .env.
#
# Nothing in this file is a secret today: the app needs no API keys. Credentials for data
# sources (PhysioNet / Google BigQuery for MIMIC-IV, the Kaggle API) belong only in your local
# .env or your own credential store, never in the repo.
#
# docker-compose.yml does not read these values for the backend. To change a flag in Docker,
# put it under pulse-backend.environment in a compose override file (see docs/HANDOFF.md).
# For a local, non-Docker run, export them in your shell or load this file yourself.

# Database. Unset = local SQLite file (data/db/). Docker Compose sets its own Postgres URL.
DATABASE_URL=

# Research feature flags (src/feature_flags.py). Keep every one OFF for the demo and for
# anything compared against results-v1.
PIPELINE_MODE=fresh
ENABLE_BCG_MODIFIERS=0
ENABLE_HR_BASELINE=0
ENABLE_ALERT_HYSTERESIS=0
ENABLE_SCENARIO_PERSISTENCE=0

# Scenario-test harness only: where a flag-on rerun writes its outputs. Unset = default location.
SCENARIO_TEST_OUTPUT_DIR=

# Frontend (frontend/.env for `npm run dev`; a build arg in docker-compose.yml).
VITE_API_URL=http://localhost:8000
VITE_USE_MOCK=false

# Data-source credentials, only if you rebuild the raw datasets (see docs/HANDOFF.md §7).
# KAGGLE_USERNAME=
# KAGGLE_KEY=
# GOOGLE_APPLICATION_CREDENTIALS=
